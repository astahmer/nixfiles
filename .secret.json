{
  "secrets": {
    "github-token": {
      "item": "nixfiles/github-token",
      "field": "password",
      "env": "GITHUB_TOKEN"
    },
    "gemini-api-key": {
      "item": "nixfiles/gemini-api-key",
      "field": "password",
      "env": "GEMINI_API_KEY"
    },
    "opencode-go-alex": {
      "item": "nixfiles/opencode-go-alex",
      "field": "password",
      "env": "OPENCODE_GO_ALEX"
    },
    "ssh-private-key-work": {
      "item": "nixfiles/ssh-private-key-work",
      "field": "notes",
      "env": "SSH_PRIVATE_KEY_WORK",
      "type": "secure-note"
    },
    "ssh-public-key-work": {
      "item": "nixfiles/ssh-public-key-work",
      "field": "notes",
      "env": "SSH_PUBLIC_KEY_WORK",
      "type": "secure-note"
    },
    "tavily-api": {
      "item": "nixfiles/tavily-api",
      "field": "password",
      "env": "TAVILY_API"
    },
    "openai-key": {
      "item": "nixfiles/openai-key",
      "field": "password",
      "env": "OPENAI_API_KEY"
    }
  }
}
