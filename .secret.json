{
  "secrets": {
    "github-token": {
      "item": "nixfiles/github-token",
      "field": "password",
      "env": "GITHUB_TOKEN"
    },
    "gemini-api-key": {
      "item": "nixfiles/gemini-api-key",
      "field": "password",
      "env": "GEMINI_API_KEY"
    },
    "opencodex-commandcode-api-key": {
      "item": "nixfiles/opencodex-commandcode-api-key",
      "field": "password",
      "env": "OPENCODEX_COMMANDCODE_API_KEY"
    },
    "ssh-private-key": {
      "item": "nixfiles/ssh-private-key",
      "field": "notes",
      "type": "secure-note",
      "env": "SSH_PRIVATE_KEY"
    },
    "opencode-go-alex": {
      "item": "nixfiles/opencode-go-alex",
      "field": "password",
      "env": "OPENCODEX_OPENCODE_GO_API_KEY"
    }
  }
}
