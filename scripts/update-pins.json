  ],
  "validations": {
    "fast": [
      {
        "name": "flake check",
        "command": [
          "nix",
          "flake",
          "check",
          "--no-build",
          "--all-systems"
        ]
      },
      {
        "name": "macOS Home Manager evaluation",
        "command": [
          "nix",
          "eval",
          ".#homeConfigurations.macbook.activationPackage.drvPath",
          "--raw"
        ]
      },
      {
        "name": "NixOS evaluation",
        "systems": [
          "x86_64-linux"
        ],
        "command": [
          "nix",
          "eval",
          ".#nixosConfigurations.workstation.config.system.build.toplevel.drvPath",
          "--raw"
        ]
      }
    ],
    "prebuilt": [
      {
        "name": "prebuilt agent binaries",
        "command": [
          "nix",
          "build",
          ".#codex",
          ".#iris",
          ".#modlens",
          ".#nub",
          ".#ryu",
          ".#zed",
          "--no-link"
        ]
      }
    ]
  }
}
