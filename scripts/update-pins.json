{
  "updates": [
    {
      "name": "claude-desktop",
      "type": "manual",
      "description": "Claude Desktop release ZIP and build revision move together",
      "enabled": false,
      "systems": [
        "aarch64-darwin"
      ],
      "command": [
        "nix",
        "run",
        "nixpkgs#nix-update",
        "--",
        "--flake",
        "claude-desktop"
      ]
    },
    {
      "name": "codex",
      "type": "nix-update",
      "description": "Codex CLI prebuilt release archive",
      "command": [
        "nix",
        "run",
        "nixpkgs#nix-update",
        "--",
        "--flake",
        "codex",
        "--use-github-releases",
        "--github-releases-limit",
        "100",
        "--version-regex",
        "rust-v(.*)"
      ]
    },
    {
      "name": "codexbar",
      "type": "nix-update",
      "description": "CodexBar macOS menu bar app release archive",
