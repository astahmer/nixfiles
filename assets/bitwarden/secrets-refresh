#!/bin/sh
set -eu

readonly opencode_go_item="nixfiles/opencodex-opencode-go-api-key"
readonly github_item="nixfiles/github-token"
readonly home_dir="${HOME:?}"
readonly opencodex_file="$home_dir/.config/opencodex/secrets.env"
readonly github_file="$home_dir/.config/opencode/github-token"

if ! command -v bw >/dev/null 2>&1; then
  printf '%s\n' 'secrets-refresh: Bitwarden CLI (bw) is not installed.' >&2
  exit 1
fi

status="$(bw status 2>/dev/null || true)"
case "$status" in
  *'"status":"unlocked"'*) ;;
  *)
    printf '%s\n' 'secrets-refresh: Bitwarden is not authenticated and unlocked; run bw login/unlock first.' >&2
    exit 1
    ;;
esac

get_secret() {
  value="$(bw get password "$1" --quiet 2>/dev/null || true)"
  if [ -z "$value" ] || [ "$value" = "replace-me" ] || [ "$value" = "REPLACE-ME" ]; then
    printf 'secrets-refresh: Bitwarden item %s is missing or empty.\n' "$1" >&2
    exit 1
  fi
  printf '%s' "$value"
}

write_file() {
  destination="$1"
  contents="$2"
  directory="$(dirname "$destination")"
  mkdir -p "$directory"
  temporary="$destination.tmp.$$"
  (umask 077; printf '%s\n' "$contents" > "$temporary")
  chmod 600 "$temporary"
  mv "$temporary" "$destination"
}

opencode_go_key="$(get_secret "$opencode_go_item")"
github_token="$(get_secret "$github_item")"

write_file "$opencodex_file" "OPENCODEX_OPENCODE_GO_API_KEY=$opencode_go_key"
write_file "$github_file" "$github_token"
chmod 600 "$opencodex_file" "$github_file"
printf '%s\n' "secrets-refresh: updated local secret projections."
