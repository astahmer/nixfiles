#!/bin/sh
# Launcher for the DeepSeek Harness app bundle and `dsh-web`: keeps the Mac awake
# and restarts `dsh web` if it exits unexpectedly. Plain `dsh web` works too; it
# just runs without the supervisor.
set -eu

# The supervisor syncs the web profile from this dshfiles checkout before each start.
DSHFILES_DIR="${DSHFILES_DIR:-@dshfilesCheckout@}"
export DSHFILES_DIR

# Nix git first: a login shell puts Apple's older git ahead of the Nix profile, and jj needs git >= 2.41.
# jj is pinned too: the Host's jj-integration shells out to it, and a non-login launch has no Nix profile on PATH.
PATH="@gitBin@:@jjBin@:$PATH"
export PATH

exec /usr/bin/caffeinate -i fnm exec --using=v22.23.3 -- node "$HOME/.local/bin/dsh-web-supervisor.mjs" "$@"
