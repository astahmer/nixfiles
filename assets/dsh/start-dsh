#!/bin/sh
# Launcher for the DeepSeek Harness app bundle and `dsh-web`: keeps the Mac awake
# and restarts `dsh web` if it exits unexpectedly. Plain `dsh web` works too; it
# just runs without the supervisor.
set -eu

# The supervisor syncs the web profile from this dshfiles checkout before each start.
DSHFILES_DIR="${DSHFILES_DIR:-@dshfilesCheckout@}"
export DSHFILES_DIR

# Nix git first: a login shell puts Apple's older git ahead of the Nix profile, and jj needs git >= 2.41.
# jj is pinned too: the Host's jj-integration shells out to it, and a non-login launch has no Nix profile on PATH.
# The Home Manager profile goes last: a dev-shell launch may have dropped it, and `secret` (plugin secret
# lookups) plus `direnv` live only there, but its node/pnpm must never shadow the fnm toolchain.
PATH="@gitBin@:@jjBin@:$PATH:@profileBin@"
export PATH

@otelEnv@

# Reuse compiled modules across Host starts: boot drops from 5-6 s to about 2.5 s with the web profile.
NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/dshfiles/node-compile-cache}"
export NODE_COMPILE_CACHE

exec /usr/bin/caffeinate -i fnm exec --using=v24.11.1 -- node "$HOME/.local/bin/dsh-web-supervisor.mjs" "$@"
