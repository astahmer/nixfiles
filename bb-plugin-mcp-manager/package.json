{
  "name": "bb-plugin-mcp-manager",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern 'dist/**'",
    "fmt": "oxfmt --write server.ts app.tsx catalog.ts catalog-icons.ts components lib package.json tsconfig.json",
    "fmt:check": "oxfmt --check server.ts app.tsx catalog.ts catalog-icons.ts components lib package.json tsconfig.json",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.12",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "packageManager": "pnpm@12.3.4",
  "bb": {
    "name": "MCP Manager",
    "description": "Add global MCP servers, handle OAuth, and control which servers are enabled for agents.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  }
}
