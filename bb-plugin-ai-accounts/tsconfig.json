{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "host.ts", "app.tsx", "usage-history.ts", "usage-sources.ts"]
}
